interface Control {
  void start(in long id);
};

valuetype BaseRecord {
  public long key;
};

exception Failure {
  string reason;
};

valuetype Record : truncatable BaseRecord supports Control {
  public long id;
  private long label;
  factory create(in long id) raises (Failure);
  long value();
};

valuetype RecordBox long;

eventtype Changed {
  public long value;
};

porttype ControlPorts {
  provides Control endpoint;
  uses multiple Control observers;
  attribute long count;
};

component Worker supports Control {
  provides Control endpoint;
  uses multiple Control peers;
  emits Changed event_source;
  publishes Changed event_stream;
  consumes Changed event_sink;
  port ControlPorts port_group;
  mirrorport ControlPorts mirrored_port_group;
  attribute long count;
};

typedef long WorkerId;

home WorkerHome manages Worker primarykey WorkerId {
  factory create(in long id);
  finder find(in long id) raises (Failure);
};

connector BaseConnector {};

connector LoggingConnector : BaseConnector {
  provides Control facet;
  uses multiple Control subscribers;
  port ControlPorts port_group;
  mirrorport ControlPorts mirrored_port_group;
};
