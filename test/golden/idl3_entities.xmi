<xmi:XMI xmlns:xmi='http://www.omg.org/spec/XMI/20131001' xmlns:uml='http://www.omg.org/spec/UML/20161101' xmlns:idl2xmi='https://github.com/jwillemsen/idl2xmi/profile' xmi:version='2.5.1'>
  <uml:Model xmi:id='idl2xmi-model' name='IDL model'>
    <packagedElement xmi:type='uml:Interface' xmi:id='idl2xmi-Control' name='Control' isAbstract='false' idl2xmi:local='false' idl2xmi:pseudo='false'>
      <ownedOperation xmi:type='uml:Operation' xmi:id='idl2xmi-Control__start' name='start'>
        <ownedParameter xmi:type='uml:Parameter' type='int32_t' xmi:id='idl2xmi-Control__start__id' name='id' direction='in'/>
      </ownedOperation>
    </packagedElement>
    <packagedElement xmi:type='uml:Class' xmi:id='idl2xmi-BaseRecord' name='BaseRecord' isAbstract='false' idl2xmi:kind='valuetype' idl2xmi:custom='false' idl2xmi:truncatable='false'>
      <ownedAttribute xmi:type='uml:Property' type='int32_t' xmi:id='idl2xmi-BaseRecord__key' name='key' idl2xmi:visibility='public'/>
    </packagedElement>
    <packagedElement xmi:type='uml:DataType' xmi:id='idl2xmi-Failure' name='Failure' idl2xmi:kind='exception'>
      <ownedAttribute xmi:type='uml:Property' type='std::string' xmi:id='idl2xmi-Failure__reason' name='reason'/>
    </packagedElement>
    <packagedElement xmi:type='uml:Class' xmi:id='idl2xmi-Record' name='Record' isAbstract='false' idl2xmi:kind='valuetype' idl2xmi:custom='false' idl2xmi:truncatable='true' idl2xmi:supports='idl2xmi-Control'>
      <generalization xmi:type='uml:Generalization' xmi:id='idl2xmi-Record__BaseRecord' general='idl2xmi-BaseRecord'/>
      <ownedAttribute xmi:type='uml:Property' type='int32_t' xmi:id='idl2xmi-Record__id' name='id' idl2xmi:visibility='public'/>
      <ownedAttribute xmi:type='uml:Property' type='int32_t' xmi:id='idl2xmi-Record__label' name='label' idl2xmi:visibility='private'/>
      <ownedOperation xmi:type='uml:Operation' xmi:id='idl2xmi-Record__value' name='value'>
        <ownedParameter xmi:type='uml:Parameter' type='int32_t' xmi:id='idl2xmi-Record__value__return' name='return' direction='return'/>
      </ownedOperation>
      <ownedOperation xmi:type='uml:Operation' xmi:id='idl2xmi-Record__create' name='create' idl2xmi:kind='factory' raisedException='idl2xmi-Failure'>
        <ownedParameter xmi:type='uml:Parameter' type='int32_t' xmi:id='idl2xmi-Record__create__id' name='id' direction='in'/>
      </ownedOperation>
    </packagedElement>
    <packagedElement xmi:type='uml:DataType' xmi:id='idl2xmi-RecordBox' name='RecordBox' idl2xmi:kind='valuebox' idl2xmi:boxedType='int32_t'/>
    <packagedElement xmi:type='uml:Class' xmi:id='idl2xmi-Changed' name='Changed' isAbstract='false' idl2xmi:kind='eventtype' idl2xmi:custom='false' idl2xmi:truncatable='false'>
      <ownedAttribute xmi:type='uml:Property' type='int32_t' xmi:id='idl2xmi-Changed__value' name='value' idl2xmi:visibility='public'/>
    </packagedElement>
    <packagedElement xmi:type='uml:Component' xmi:id='idl2xmi-Worker' name='Worker' idl2xmi:kind='component' idl2xmi:supports='idl2xmi-Control'>
      <ownedPort xmi:type='uml:Port' type='idl2xmi-Control' xmi:id='idl2xmi-Worker__endpoint' name='endpoint' idl2xmi:kind='facet' idl2xmi:multiple='false'/>
      <ownedPort xmi:type='uml:Port' type='idl2xmi-Control' xmi:id='idl2xmi-Worker__peers' name='peers' idl2xmi:kind='receptacle' idl2xmi:multiple='true'/>
      <ownedPort xmi:type='uml:Port' type='idl2xmi-Changed' xmi:id='idl2xmi-Worker__event_source' name='event_source' idl2xmi:kind='emitter' idl2xmi:multiple='false'/>
      <ownedPort xmi:type='uml:Port' type='idl2xmi-Changed' xmi:id='idl2xmi-Worker__event_stream' name='event_stream' idl2xmi:kind='publisher' idl2xmi:multiple='false'/>
      <ownedPort xmi:type='uml:Port' type='idl2xmi-Changed' xmi:id='idl2xmi-Worker__event_sink' name='event_sink' idl2xmi:kind='consumer' idl2xmi:multiple='false'/>
      <ownedPort xmi:type='uml:Port' type='idl2xmi-ControlPorts' xmi:id='idl2xmi-Worker__port_group' name='port_group' idl2xmi:kind='port' idl2xmi:multiple='false'/>
      <ownedPort xmi:type='uml:Port' type='idl2xmi-ControlPorts' xmi:id='idl2xmi-Worker__mirrored_port_group' name='mirrored_port_group' idl2xmi:kind='mirrorport' idl2xmi:multiple='false'/>
      <ownedAttribute xmi:type='uml:Property' type='int32_t' xmi:id='idl2xmi-Worker__count' name='count' isReadOnly='false'/>
    </packagedElement>
    <packagedElement xmi:type='uml:DataType' xmi:id='idl2xmi-WorkerId' name='WorkerId' idl2xmi:kind='typedef' idl2xmi:aliasedType='int32_t'/>
    <packagedElement xmi:type='uml:Class' xmi:id='idl2xmi-WorkerHome' name='WorkerHome' idl2xmi:kind='home' idl2xmi:manages='idl2xmi-Worker'>
      <ownedOperation xmi:type='uml:Operation' xmi:id='idl2xmi-WorkerHome__create' name='create' idl2xmi:kind='factory'>
        <ownedParameter xmi:type='uml:Parameter' type='int32_t' xmi:id='idl2xmi-WorkerHome__create__id' name='id' direction='in'/>
      </ownedOperation>
      <ownedOperation xmi:type='uml:Operation' xmi:id='idl2xmi-WorkerHome__find' name='find' idl2xmi:kind='finder' raisedException='idl2xmi-Failure'>
        <ownedParameter xmi:type='uml:Parameter' type='int32_t' xmi:id='idl2xmi-WorkerHome__find__id' name='id' direction='in'/>
      </ownedOperation>
    </packagedElement>
    <packagedElement xmi:type='uml:Component' xmi:id='idl2xmi-BaseConnector' name='BaseConnector' idl2xmi:kind='connector'/>
    <packagedElement xmi:type='uml:Component' xmi:id='idl2xmi-LoggingConnector' name='LoggingConnector' idl2xmi:kind='connector'>
      <generalization xmi:type='uml:Generalization' xmi:id='idl2xmi-LoggingConnector__BaseConnector' general='idl2xmi-BaseConnector'/>
      <ownedPort xmi:type='uml:Port' type='idl2xmi-Control' xmi:id='idl2xmi-LoggingConnector__facet' name='facet' idl2xmi:kind='facet' idl2xmi:multiple='false'/>
      <ownedPort xmi:type='uml:Port' type='idl2xmi-Control' xmi:id='idl2xmi-LoggingConnector__subscribers' name='subscribers' idl2xmi:kind='receptacle' idl2xmi:multiple='true'/>
      <ownedPort xmi:type='uml:Port' type='idl2xmi-ControlPorts' xmi:id='idl2xmi-LoggingConnector__port_group' name='port_group' idl2xmi:kind='port' idl2xmi:multiple='false'/>
      <ownedPort xmi:type='uml:Port' type='idl2xmi-ControlPorts' xmi:id='idl2xmi-LoggingConnector__mirrored_port_group' name='mirrored_port_group' idl2xmi:kind='mirrorport' idl2xmi:multiple='false'/>
    </packagedElement>
    <packagedElement xmi:type='uml:Interface' xmi:id='idl2xmi-ControlPorts' name='ControlPorts' idl2xmi:kind='porttype'>
      <ownedPort xmi:type='uml:Port' type='idl2xmi-Control' xmi:id='idl2xmi-ControlPorts__endpoint' name='endpoint' idl2xmi:kind='facet' idl2xmi:multiple='false'/>
      <ownedPort xmi:type='uml:Port' type='idl2xmi-Control' xmi:id='idl2xmi-ControlPorts__observers' name='observers' idl2xmi:kind='receptacle' idl2xmi:multiple='true'/>
      <ownedAttribute xmi:type='uml:Property' type='int32_t' xmi:id='idl2xmi-ControlPorts__count' name='count' isReadOnly='false'/>
    </packagedElement>
  </uml:Model>
</xmi:XMI>
