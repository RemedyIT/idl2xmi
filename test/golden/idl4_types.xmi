<xmi:XMI xmlns:xmi='http://www.omg.org/spec/XMI/20131001' xmlns:uml='http://www.omg.org/spec/UML/20161101' xmlns:idl2xmi='https://github.com/jwillemsen/idl2xmi/profile' xmi:version='2.5.1'>
  <uml:Model xmi:id='idl2xmi-model' name='IDL model'>
    <packagedElement xmi:type='uml:Package' xmi:id='idl2xmi-Modern' name='Modern'>
      <packagedElement xmi:type='uml:DataType' xmi:id='idl2xmi-Modern__Label' name='Label' idl2xmi:kind='typedef' idl2xmi:aliasedType='TAOX11_IDL::bounded_string&lt;32&gt;'/>
      <packagedElement xmi:type='uml:DataType' xmi:id='idl2xmi-Modern__Ints' name='Ints' idl2xmi:kind='typedef' idl2xmi:aliasedType='TAOX11_NAMESPACE::IDL::bounded_vector&lt;int32_t, 3&gt;'/>
      <packagedElement xmi:type='uml:DataType' xmi:id='idl2xmi-Modern__StringMap' name='StringMap' idl2xmi:kind='typedef' idl2xmi:aliasedType='TAOX11_NAMESPACE::IDL::bounded_map&lt;::Modern::Label, ::Modern::Ints, 8&gt;'/>
      <packagedElement xmi:type='uml:DataType' xmi:id='idl2xmi-Modern__Values' name='Values'>
        <idl2xmi:annotation xmi:id='idl2xmi-Modern__Values__annotation0' name='marker'/>
        <ownedAttribute xmi:type='uml:Property' type='int8_t' xmi:id='idl2xmi-Modern__Values__tiny' name='tiny'/>
        <ownedAttribute xmi:type='uml:Property' type='uint16_t' xmi:id='idl2xmi-Modern__Values__small' name='small'/>
        <ownedAttribute xmi:type='uml:Property' type='::Modern::StringMap' xmi:id='idl2xmi-Modern__Values__lookup' name='lookup'/>
        <ownedAttribute xmi:type='uml:Property' type='::Modern::Label' xmi:id='idl2xmi-Modern__Values__label_value' name='label_value'/>
      </packagedElement>
      <packagedElement xmi:type='uml:Enumeration' xmi:id='idl2xmi-Modern__Permissions' name='Permissions' idl2xmi:kind='bitmask' idl2xmi:bitBound='3'>
        <ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='idl2xmi-Modern__Permissions__read' name='read' idl2xmi:position='0' idl2xmi:mask='1'/>
        <ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='idl2xmi-Modern__Permissions__write' name='write' idl2xmi:position='1' idl2xmi:mask='2'/>
        <ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='idl2xmi-Modern__Permissions__execute' name='execute' idl2xmi:position='2' idl2xmi:mask='4'/>
      </packagedElement>
      <packagedElement xmi:type='uml:DataType' xmi:id='idl2xmi-Modern__Header' name='Header' idl2xmi:kind='bitset'>
        <ownedAttribute xmi:type='uml:Property' type='bool' xmi:id='idl2xmi-Modern__Header__present' name='present' idl2xmi:bits='1'/>
        <ownedAttribute xmi:type='uml:Property' type='uint8_t' xmi:id='idl2xmi-Modern__Header__flags' name='flags' idl2xmi:bits='7'/>
        <ownedAttribute xmi:type='uml:Property' type='int16_t' xmi:id='idl2xmi-Modern__Header__identifier' name='identifier' idl2xmi:bits='16'/>
      </packagedElement>
    </packagedElement>
  </uml:Model>
</xmi:XMI>
